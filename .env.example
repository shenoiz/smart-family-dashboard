# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it is listed in .gitignore.

# ── Telegram ──────────────────────────────────────────────
# Get a token from @BotFather on Telegram (send it: /newbot)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your numeric Telegram user ID from @userinfobot
TELEGRAM_USER_ID_HIM=YOUR_TELEGRAM_USER_ID
TELEGRAM_USER_ID_HER=PARTNER_TELEGRAM_USER_ID

# ── Weather (OpenWeatherMap — free tier) ─────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY
CITY=YourCity
WEATHER_UNITS=metric

# ── Google Drive photo sync ──────────────────────────────
# Folder ID comes from the Drive folder URL:
# drive.google.com/drive/folders/THIS_PART_HERE
GOOGLE_DRIVE_FOLDER_ID=YOUR_FOLDER_ID
# credentials.json (service account key) goes in the project root,
# is never committed, and is separate from this file.

# ── Hindu Panchang (Prokerala API) ───────────────────────
# OAuth2 client credentials from api.prokerala.com dashboard
PROKERALA_CLIENT_ID=YOUR_PROKERALA_CLIENT_ID
PROKERALA_CLIENT_SECRET=YOUR_PROKERALA_CLIENT_SECRET
PROKERALA_LATITUDE=YOUR_LATITUDE
PROKERALA_LONGITUDE=YOUR_LONGITUDE

# ── Schedule ──────────────────────────────────────────────
SHUTDOWN_TIME=23:00
GOOD_MORNING_TIME=07:05
